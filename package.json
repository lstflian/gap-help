{
    "name": "gap-help",
    "displayName": "GAP Help",
    "description": "Search and read GAP documentation directly in VS Code, powered by the native GAP help system",
    "version": "0.3.2",
    "publisher": "flianlee",
    "license": "SEE LICENSE IN LICENSE",
    "author": "Songtai Li",
    "icon": "icon/icon.png",
    "categories": ["Education"],
    "keywords": ["gap", "algebra", "group theory", "help", "documentation", "mathematics"],
    "repository": {
        "type": "git",
        "url": "https://github.com/lstflian/gap-help"
    },
    "engines": {
        "vscode": "^1.105.0"
    },
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "gap-help.search",
                "title": "Help in GAP",
                "category": "GAP"
            },
            {
                "command": "gap-help.rebuild",
                "title": "Rebuild Help Index",
                "category": "GAP"
            },
            {
                "command": "gap-help.openReference",
                "title": "Open GAP Reference Manual",
                "category": "GAP"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "gap-help.search",
                    "when": "resourceExtname == .g || resourceExtname == .gi || resourceExtname == .gd",
                    "group": "navigation"
                },
                {
                    "command": "gap-help.openReference",
                    "when": "resourceExtname == .g || resourceExtname == .gi || resourceExtname == .gd",
                    "group": "navigation"
                }
            ]
        },
        "configuration": {
            "title": "GAP Help",
            "properties": {
                "gap-help.gapPath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Path to GAP installation root (the folder containing `doc/` and `pkg/`). Examples:\n\nGAP installed via the `.exe` installer: `C:\\Program Files\\GAP-4.16.0\\runtime\\opt\\gap-4.16.0`\n\nGAP built from source: `/home/user/gap-4.16.0`"
                },
                "gap-help.searchMode": {
                    "type": "string",
                    "enum": [
                        "prefix",
                        "substring"
                    ],
                    "default": "prefix",
                    "description": "Search mode: prefix (?topic) matches from the start of a word, substring (??topic) matches anywhere"
                },
                "gap-help.helpStyle": {
                    "type": "string",
                    "enum": [
                        "native"
                    ],
                    "default": "native",
                    "description": "Help page rendering style. Currently only 'native' (GAP original look) is available."
                },
                "gap-help.docAppearance": {
                    "type": "string",
                    "enum": [
                        "system",
                        "dark",
                        "light"
                    ],
                    "default": "system",
                    "description": "Appearance of GAP documentation pages: 'system' follows the VS Code theme, 'dark'/'light' force a mode for all manuals."
                },
                "gap-help.mathJax": {
                    "type": "boolean",
                    "default": true,
                    "description": "Render math in GAP documentation pages with MathJax. The [MathJax on/off] link inside the docs toggles this setting."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "tsc -p ./",
        "compile": "tsc -p ./",
        "test": "npm run compile && node test/run-all.js"
    },
    "devDependencies": {
        "@types/node": "^18.0.0",
        "@types/vscode": "^1.105.0",
        "typescript": "^5.0.0"
    }
}
